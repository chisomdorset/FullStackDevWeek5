@page "/products"

@using System.Linq
@using FullStackDevWeek5.Models
@using FullStackDevWeek5.Services

@inject NavigationManager Nav
@inject ProductService ProductService

@rendermode InteractiveServer

<h3>Product List</h3>

<div class="mb-3">
    <button class="btn btn-success"
            @onclick='() => Nav.NavigateTo("/createproduct")'>
        <i class="bi bi-plus-circle"></i>
        Add New Product
    </button>
</div>

<div class="row mb-3">

    <div class="col-md-4">
        <input class="form-control"
               placeholder="Search by Name, Category or Description..."
               @bind="searchText"
               @bind:event="oninput" />
    </div>

    <div class="col-md-8 text-end">
        <h5>
            Total Products: @products.Count |
            Found: @FilteredProducts.Count()
        </h5>
    </div>

</div>

@if (products.Count == 0)
{
    <div class="alert alert-info">
        Loading products...
    </div>
}
else if (!FilteredProducts.Any())
{
    <div class="alert alert-warning">
        No products found matching "@searchText"
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">

        <table class="table table-hover table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Barcode</th>
                    <th>Product Code</th>
                    <th>Created Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in FilteredProducts)
                {
                    <tr>

                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>@product.Category</td>
                        <td>@product.Barcode</td>
                        <td>@product.ProductCode</td>
                        <td>@product.CreatedDate</td>

                        <td class="text-center">

                            <div class="row">

                                <button class="btn btn-sm btn-primary me-1"
                                        title="View"
                                        @onclick="() => ViewProduct(product.Id)">
                                    <i class="bi bi-eye"></i>
                                    View
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-warning me-1"
                                        title="Edit"
                                        @onclick="() => EditProduct(product.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-danger"
                                        title="Delete"
                                        @onclick="() => DeleteProduct(product.Id)">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

@code {

    [Parameter]
    public List<Product> products { get; set; } = new();

    private string searchText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            products = (await ProductService.GetProductsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }

    private IEnumerable<Product> FilteredProducts =>
    products.Where(p =>
    string.IsNullOrWhiteSpace(searchText) ||

    (p.Name?.Contains(
    searchText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (p.Category?.Contains(
    searchText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (p.Description?.Contains(
    searchText,
    StringComparison.OrdinalIgnoreCase) ?? false)
    );

    private void ViewProduct(int id)
    {
        Nav.NavigateTo($"/product/view/{id}");
    }

    private void EditProduct(int id)
    {
        Nav.NavigateTo($"/editproduct/{id}");
    }

    private async Task DeleteProduct(int id)
    {
        try
        {
            // Uncomment when your API delete endpoint works

            // await ProductService.DeleteProductAsync(id);

            var item = products.FirstOrDefault(p => p.Id == id);

            if (item != null)
            {
                products.Remove(item);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        await Task.CompletedTask;
    }

}




  
