@using FullStackDevWeek5.Models;
@inject NavigationManager Nav
@using FullStackDevWeek5.Services;
@inject ProductService ProductService
@inject SchoolService SchoolService

@rendermode InteractiveServer

@page "/"

<PageTitle>Home</PageTitle>

<div class="row">

<div class="col-lg-6">
    <div class="mb-3">
    <button class="btn btn-success"
            @onclick='() => Nav.NavigateTo("/createproduct")'>
        <i class="bi bi-plus-circle"></i>
        Add New Product
    </button>
</div>

<div class="row mb-3">

    <div class="col-md-4">
        <input class="form-control"
               placeholder="Search by Name, Category or Description..."
               @bind="searchProductText"
               @bind:event="oninput" />
    </div>

    <div class="col-md-8 text-end">
        <h5>
            Total Products: @products.Count |
            Found: @FilteredProducts.Count()
        </h5>
    </div>

</div>

@if (products.Count == 0)
{
    <div class="alert alert-info">
        Loading products...
    </div>
}
else if (!FilteredProducts.Any())
{
    <div class="alert alert-warning">
        No products found matching "@searchProductText"
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">

        <table class="table table-hover table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Category</th>
                    <th>Barcode</th>
                    <th>Product Code</th>
                    <th>Created Date</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var product in FilteredProducts)
                {
                    <tr>

                        <td>@product.Id</td>
                        <td>@product.Name</td>
                        <td>@product.Description</td>
                        <td>@product.Category</td>
                        <td>@product.Barcode</td>
                        <td>@product.ProductCode</td>
                        <td>@product.CreatedDate</td>

                        <td class="text-center">

                            <div class="row">

                                <button class="btn btn-sm btn-primary me-1"
                                        title="View"
                                        @onclick="() => ViewProduct(product.Id)">
                                    <i class="bi bi-eye"></i>
                                    View
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-warning me-1"
                                        title="Edit"
                                        @onclick="() => EditProduct(product.Id)">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-danger"
                                        title="Delete"
                                        @onclick="() => DeleteProduct(product.Id)">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}
</div>


<div class="col-lg-6"> 

    <div class="mb-3">
    <button class="btn btn-success"
            @onclick='() => Nav.NavigateTo("/createschool")'>
        <i class="bi bi-plus-circle"></i>
        Add New School
    </button>
</div>

<div class="row mb-3">

    <div class="col-md-4">
        <input class="form-control"
               placeholder="Search by Name, Category or Description..."
               @bind="searchSchoolText"
               @bind:event="oninput" />
    </div>

    <div class="col-md-8 text-end">
        <h5>
            Total Schools: @schools.Count |
            Found: @FilteredSchools.Count()
        </h5>
    </div>

</div>

@if (schools.Count == 0)
{
    <div class="alert alert-info">
        Loading schools...
    </div>
}
else if (!FilteredSchools.Any())
{
    <div class="alert alert-warning">
        No schools found matching "@searchSchoolText"
    </div>
}
else
{
    <div class="table-responsive shadow-sm rounded-3">

        <table class="table table-hover table-striped align-middle">

            <thead class="table-dark">
                <tr>
                    <th>School Id</th>
                    <th>SchoolName</th>
                    <th>Address</th>
                    <th>Phone Number</th>
                    <th>EmailAddress</th>
                    <th>Proprietor Full Name</th>
                    <th>Head Full Name</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var school in FilteredSchools)
                {
                    <tr>

                        <td>@school.SchoolId</td>
                        <td>@school.SchoolName</td>
                        <td>@school.Address</td>
                        <td>@school.PhoneNo</td>
                        <td>@school.EmailAddress</td>
                        <td>@school.ProprietorFullName</td>
                        <td>@school.HeadFullName</td>
                       

                        <td class="text-center">

                            <div class="row">

                                <button class="btn btn-sm btn-primary me-1"
                                        title="View"
                                        @onclick="() => ViewSchool(school.SchoolId)">
                                    <i class="bi bi-eye"></i>
                                    View
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-warning me-1"
                                        title="Edit"
                                        @onclick="() => EditSchool(school.SchoolId)">
                                    <i class="bi bi-pencil-square"></i>
                                    Edit
                                </button>
                            </div>

                            <div class="row">
                                <button class="btn btn-sm btn-danger"
                                        title="Delete"
                                        @onclick="() => DeleteSchool(school.SchoolId)">
                                    <i class="bi bi-trash"></i>
                                    Delete
                                </button>
                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>
}

 </div>

</div>





@code{


     [Parameter]
    public List<Product> products { get; set; } = new();

    public List<School> schools { get; set; } = new();

    private string searchProductText = string.Empty;
    private string searchSchoolText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
       
        try
        {
   
            products = (await ProductService.GetProductsAsync()).ToList();
            schools = (await SchoolService.GetSchoolsAsync()).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during initialization: {ex.Message}");
        }

    }


 private IEnumerable<Product> FilteredProducts =>
    products.Where(p =>
    string.IsNullOrWhiteSpace(searchProductText) ||

    (p.Name?.Contains(
    searchProductText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (p.Category?.Contains(
    searchProductText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (p.Description?.Contains(
    searchProductText,
    StringComparison.OrdinalIgnoreCase) ?? false)
    );



     private void ViewProduct(int id)
    {
        Nav.NavigateTo($"/product/view/{id}");
    }

    private void EditProduct(int id)
    {
        Nav.NavigateTo($"/editproduct/{id}");
    }

    private async Task DeleteProduct(int id)
    {
        try
        {
            // Uncomment when your API delete endpoint works

            // await ProductService.DeleteProductAsync(id);

            var item = products.FirstOrDefault(p => p.Id == id);

            if (item != null)
            {
                products.Remove(item);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        await Task.CompletedTask;
    }






     private IEnumerable<School> FilteredSchools =>
    schools.Where(s =>
    string.IsNullOrWhiteSpace(searchSchoolText) ||

    (s.SchoolName?.Contains(
    searchSchoolText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (s.Address?.Contains(
    searchSchoolText,
    StringComparison.OrdinalIgnoreCase) ?? false)

    ||

    (s.HeadFullName?.Contains(
    searchSchoolText,
    StringComparison.OrdinalIgnoreCase) ?? false)
    );

    private void ViewSchool(int schoolId)
    {
        Nav.NavigateTo($"/school/view/{schoolId}");
    }

    private void EditSchool(int schoolId)
    {
        Nav.NavigateTo($"/editschool/{schoolId}");
    }

    private async Task DeleteSchool(int schoolId)
    {
        try
        {
        

            var item = schools.FirstOrDefault(s => s.SchoolId == schoolId);

            if (item != null)
            {
                schools.Remove(item);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }

        await Task.CompletedTask;
    }



}