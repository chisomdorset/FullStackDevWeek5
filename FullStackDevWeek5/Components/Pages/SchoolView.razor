@page "/school/view/{schoolId:int}"

@using System.Linq
@using FullStackDevWeek5.Services
@using FullStackDevWeek5.Models
@inject NavigationManager Nav
@inject SchoolService SchoolService
@rendermode InteractiveServer




<div class="school-hero mb-4">
    <div class="overlay"></div>

    <div class="container position-relative py-5 text-white">
        <div class="d-flex align-items-center">
            <img src="/images/dorset_logo.png" style="width: 100px; height: auto;" class="product-avatar me-4" />

            <div>
                <h2 class="fw-bold mb-1">@school?.SchoolName</h2>
                <p class="mb-0">@school?.Address</p>
            </div>
        </div>
    </div>
</div>

<div class="container">

    <!-- Action Buttons -->
    <div class="d-flex justify-content-end mb-3">
        <button class="btn btn-warning me-2" @onclick="EditSchool">
            <i class="bi bi-pencil-square"></i> Edit
        </button>

        <button class="btn btn-danger" @onclick="DeleteSchool">
            <i class="bi bi-trash"></i> Delete
        </button>
    </div>


    <div class="tab-content">

        <!-- Overview -->
        <div class="tab-pane fade show active" id="overview">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">School Information</h5>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">School ID:</label>
                            <div>@school?.SchoolId</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">School Name:</label>
                            <div>@school?.SchoolName</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Address:</label>
                            <div>@school?.Address</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Description:</label>
                            <div>@school?.PhoneNo</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Product Code:</label>
                            <div>@school?.EmailAddress</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Category:</label>
                            <div>@school?.ProprietorFullName</div>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="fw-bold">Barcode:</label>
                            <div>@school?.HeadFullName</div>
                        </div>

                       
                    </div>
                </div>
            </div>
        </div>

        <!-- Staff -->
        <div class="tab-pane fade" id="staff">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Staff Members</h5>
                    <p class="text-muted">Staff list will be displayed here.</p>
                </div>
            </div>
        </div>

        <!-- Classes -->
        <div class="tab-pane fade" id="classes">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Classes</h5>
                    <p class="text-muted">Class list will be displayed here.</p>
                </div>
            </div>
        </div>

        <!-- Students -->
        <div class="tab-pane fade" id="students">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Students</h5>
                    <p class="text-muted">Student list will be displayed here.</p>
                </div>
            </div>
        </div>

        <!-- Documents -->
        <div class="tab-pane fade" id="documents">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">Documents</h5>
                    <p class="text-muted">Documents will be displayed here.</p>
                </div>
            </div>
        </div>

    </div>

</div>

@code {

    [Parameter]
    public School? school { get; set; } = null;

    [Parameter] public int schoolId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        school = await SchoolService.GetSchoolByIdAsync(schoolId);
    }

    private void EditSchool() => Nav.NavigateTo($"/editschool/{schoolId}");

    private async Task DeleteSchool()
    {
        //Call delete API if needed

        Nav.NavigateTo("/school/schools");
    }
}

